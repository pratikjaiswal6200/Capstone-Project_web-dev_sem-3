PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/krmu_campus
# Set two distinct random secrets with at least 32 characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Required with NODE_ENV=production. Use an https:// origin without a path.
# PUBLIC_ORIGIN=https://campus.example.org
# Explicit opt-in for npm run seed, protected by a local MongoDB guard.
DEMO_SEED_PASSWORD=
